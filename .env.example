# AI Workbench configuration
# Copy to .env and adjust.

# --- Core ---
AIW_ENVIRONMENT=development
AIW_LOG_LEVEL=INFO

# --- Database ---
# Dev default is sqlite; production is postgres.
AIW_DATABASE_URL=sqlite+pysqlite:///./aiw.db
# AIW_DATABASE_URL=postgresql+psycopg://aiw:aiw@localhost:5432/aiw

# --- API ---
AIW_API_HOST=0.0.0.0
AIW_API_PORT=8000
AIW_CORS_ORIGINS=["http://localhost:5173"]

# --- Workspaces (k8s) ---
AIW_K8S_IN_CLUSTER=false
AIW_KUBECONFIG=
AIW_WORKSPACE_NAMESPACE_PREFIX=aiw
AIW_WORKSPACE_IMAGE=ghcr.io/coder/code-server:latest
AIW_WORKSPACE_CPU_REQUEST=500m
AIW_WORKSPACE_MEMORY_REQUEST=1Gi
AIW_WORKSPACE_STORAGE=10Gi
AIW_WORKSPACE_STORAGE_CLASS=

# --- Agents ---
AIW_OPENHANDS_URL=http://openhands:3000
AIW_LLM_GATEWAY_URL=http://litellm:4000
AIW_DEFAULT_AGENT_MODEL=local-coder

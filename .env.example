# AgentForge configuration
# Copy to .env and adjust.

# --- Core ---
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_LOG_LEVEL=INFO

# --- Database ---
# Dev default is sqlite; production is postgres.
AGENTFORGE_DATABASE_URL=sqlite+pysqlite:///./agentforge.db
# AGENTFORGE_DATABASE_URL=postgresql+psycopg://agentforge:agentforge@localhost:5432/agentforge

# --- API ---
AGENTFORGE_API_HOST=0.0.0.0
AGENTFORGE_HTTP_PORT=8000
AGENTFORGE_CORS_ORIGINS=["http://localhost:5173"]

# --- Workspaces (k8s) ---
AGENTFORGE_K8S_IN_CLUSTER=false
AGENTFORGE_KUBECONFIG=
AGENTFORGE_WORKSPACE_NAMESPACE_PREFIX=af
AGENTFORGE_WORKSPACE_IMAGE=ghcr.io/coder/code-server:latest
AGENTFORGE_WORKSPACE_CPU_REQUEST=500m
AGENTFORGE_WORKSPACE_MEMORY_REQUEST=1Gi
AGENTFORGE_WORKSPACE_STORAGE=10Gi
AGENTFORGE_WORKSPACE_STORAGE_CLASS=

# --- Agents ---
AGENTFORGE_OPENHANDS_URL=http://openhands:3000
AGENTFORGE_LLM_GATEWAY_URL=http://litellm:4000
AGENTFORGE_DEFAULT_AGENT_MODEL=local-coder
